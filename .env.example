APP_NAME="Flores D&D"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Santiago
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=flores_dyd
DB_USERNAME=root
DB_PASSWORD=

# =============================================
# SEGURIDAD - CIFRADO Y HASHING
# =============================================
# Password Peppering (generar con: openssl rand -hex 32)
PASSWORD_PEPPER=your-secret-pepper-change-in-production
# Clave para cifrado de datos sensibles en BD
DB_ENCRYPTION_KEY=your-encryption-key-change-in-production

# =============================================
# CONFIGURACIÓN DE CORREOS
# =============================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hola@floresdyd.cl"
MAIL_FROM_NAME="${APP_NAME}"

# Queue driver para emails asíncronos
QUEUE_CONNECTION=database

# =============================================
# CONFIGURACIÓN DE SESIONES
# =============================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# =============================================
# CACHÉ Y REDIS (opcional)
# =============================================
CACHE_STORE=database
CACHE_PREFIX=floresdyd_

# =============================================
# ALMACENAMIENTO
# =============================================
FILESYSTEM_DISK=local

# =============================================
# RATE LIMITING
# =============================================
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_DECAY_MINUTES=15
RATE_LIMIT_API_REQUESTS=60

# =============================================
# CONFIGURACIÓN DEL NEGOCIO
# =============================================
FLORES_ADMIN_EMAIL=admin@floresdyd.cl
FLORES_STOCK_RESERVATION_MINUTES=45
FLORES_FRAUD_SCORE_THRESHOLD=40
FLORES_CURRENCY=CLP
FLORES_TIMEZONE=America/Santiago

# =============================================
# SEEDERS (SOLO LOCAL)
# =============================================
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=
ADMIN_DEMO_EMAIL=
ADMIN_DEMO_PASSWORD=
ADMIN_DEMO_NAME=
