# ============================================================
# FLORES D&D - .htaccess RAÍZ
# ============================================================
# 
# OPCIÓN B: Si NO puedes apuntar el Document Root a /public
# Coloca este archivo en la raíz del proyecto (donde está artisan)
# para redirigir todo al directorio public/
#
# NOTA: La OPCIÓN A (preferida) es mover el contenido de public/
# a public_html/ y el resto del proyecto un nivel arriba.
# Ver DEPLOY_CPANEL.md para detalles.
# ============================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Si el archivo/directorio existe en la raíz, no redirigir
    # (esto evita loops y permite acceso a archivos necesarios)
    
    # Redirigir TODO al directorio public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ /public/$1 [L]
</IfModule>

# Bloquear acceso a archivos sensibles
<FilesMatch "^\.env|composer\.(json|lock)|package\.(json|lock)|artisan|\.gitignore|webpack\.mix\.js|vite\.config\.js|tailwind\.config\.js|phpunit\.xml|README\.md">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Bloquear acceso a directorios sensibles
RedirectMatch 403 ^/(app|bootstrap|config|database|resources|routes|storage|vendor|node_modules|tests|docs)/
